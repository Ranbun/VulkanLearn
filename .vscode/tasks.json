{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create BuildDir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "build"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": true,
                "clear": true
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe"
                    }
                },
                "args": [
                    "-Force",
                    "build"
                ]
            }
        },
        // CMake 生成
        {
            "label": "CMake::Generate",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "../"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "windows": {
                "args": [
                    "-DCMAKE_BUILD_TYPE=Debug",
                    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build",
                    "-G",
                    "Ninja"
                ],
                // 设置VC的环境
                "options": {
                    "shell": {
                        "executable": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/VC/Auxiliary/Build/vcvarsall.bat",
                        "args": [
                            "amd64",
                            "-vcvars_ver=14.3",
                            "&&"
                        ]
                    }
                }
            },
            "dependsOn": [
                "Create BuildDir"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        //CMake 编译
        {
            "label": "CMake::Build_Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "./",
                "--target",
                "all",
                "--"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "options": {
                    "shell": {
                        "executable": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Enterprise\\VC\\Auxiliary\\Build\\vcvarsall.bat",
                        "args": [
                            "amd64",
                            "-vcvars_ver=14.3",
                            "&&"
                        ]
                    }
                },
                "problemMatcher": "$msCompile"
            },
            "dependsOrder": "sequence", // 按照顺序执行
            "dependsOn": [
                "CMake::Generate"
            ]
        }
    ]
