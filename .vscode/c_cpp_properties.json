{
    "configurations": [
        {
            "name": "g++",
            "intelliSenseMode": "windows-msvc-x64",
            "windowsSdkVersion": "10.0.19041.0",
            "compilerPath": "D:/Program Files/LLVM/bin/clang++.exe",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/**",
                "${workspaceFolder}/example/triangle/*.*",
                "${vcpkgRoot}/x64-windows/include",
                "${workspaceFolder}/src/vendor/glfw/include/*.*",
                "${workspaceFolder}/src/vendor/glad/include/*.*"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/example/triangle/*.*",
                    "${vcpkgRoot}/x64-windows/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "cStandard": "c11",
            "cppStandard": "c++17",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}